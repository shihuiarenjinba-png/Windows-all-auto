{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shihuiarenjinba-png/Windows-all-auto/schemas/windows-product-qa-plan-v1.schema.json",
  "title": "Factory-bound Windows sale-preflight QA plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_slug",
    "product_type",
    "plan_version",
    "steps",
    "allowed_diagnostics",
    "forbidden_actions",
    "success_policy",
    "template_sha256",
    "source_repository",
    "source_sha",
    "package_sha256",
    "executable_sha256",
    "identity"
  ],
  "properties": {
    "schema_version": { "const": "windows-product-qa-plan-v1" },
    "product_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{3,39}$" },
    "product_type": { "enum": ["APP", "GAME", "GAME_3D"] },
    "plan_version": { "const": 1 },
    "template_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_repository": { "type": "string", "minLength": 1 },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "publisher", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "requires", "required", "params"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "action": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
          },
          "required": { "type": "boolean" },
          "params": { "type": "object" }
        }
      }
    },
    "allowed_diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
    },
    "forbidden_actions": {
      "const": [
        "SOURCE_EDIT",
        "ARBITRARY_SHELL",
        "GIT_WRITE",
        "STORE_SUBMIT",
        "STORE_PUBLISH",
        "SECURITY_POLICY_CHANGE"
      ]
    },
    "success_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_steps_must_pass",
        "evidence_return_required",
        "product_e2e_authority",
        "release_authority",
        "store_authority"
      ],
      "properties": {
        "required_steps_must_pass": { "const": true },
        "evidence_return_required": { "const": true },
        "product_e2e_authority": { "const": false },
        "release_authority": { "const": false },
        "store_authority": { "const": false }
      }
    }
  }
}
