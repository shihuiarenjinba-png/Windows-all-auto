{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shihuiarenjinba-png/Windows-all-auto/schemas/windows-qa-repair-handoff-v1.schema.json",
  "title": "Advisory Windows QA repair handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_dispatch_status", "artifact_sha256", "failed_test_ids",
    "failure_class", "missing_evidence", "observed_evidence",
    "product_e2e_pass", "recommended_owner",
    "recommended_regression_test_ids", "release_ready", "request_id",
    "retest_requires_new_source_sha", "schema_version", "source_edit_authority",
    "source_sha", "store_submission_allowed"
  ],
  "properties": {
    "schema_version": { "const": "windows-qa-repair-handoff-v1" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "request_id": { "type": "string", "minLength": 4 },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "failed_test_ids": { "type": "array", "items": { "type": "string" } },
    "failure_class": { "type": "string", "minLength": 1 },
    "observed_evidence": { "type": "array", "items": { "type": "object" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "recommended_owner": {
      "enum": ["APP", "GAME", "GAME_3D", "INFRA", "WINDOWS_E2E"]
    },
    "recommended_regression_test_ids": {
      "type": "array", "items": { "type": "string" }
    },
    "agent_dispatch_status": { "const": "AGENT_DISPATCH_PENDING" },
    "source_edit_authority": { "const": false },
    "retest_requires_new_source_sha": { "const": true },
    "product_e2e_pass": { "const": false },
    "release_ready": { "const": false },
    "store_submission_allowed": { "const": false }
  }
}
