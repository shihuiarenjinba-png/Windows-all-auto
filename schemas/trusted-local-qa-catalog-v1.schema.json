{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shihuiarenjinba-png/Windows-all-auto/schemas/trusted-local-qa-catalog-v1.schema.json",
  "title": "Hash-pinned local QA test catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tests"],
  "properties": {
    "schema_version": { "const": "trusted-local-qa-catalog-v1" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "admin_required", "allowed_product_types", "arguments_template",
          "completion_policy", "description", "destructive", "evidence_requirements", "executable",
          "expected_exit_codes", "gui_test", "max_retries", "resource_units",
          "observation_seconds", "requires_test_passes", "side_effect_class", "supported_gui_operation", "test_id",
          "timeout_seconds"
        ],
        "properties": {
          "test_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "description": { "type": "string", "minLength": 1 },
          "allowed_product_types": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["APP", "GAME", "GAME_3D"] }
          },
          "executable": {
            "enum": ["TRUSTED_ARTIFACT_PROCESS", "TRUSTED_PYTHON_QA_RUNNER"]
          },
          "arguments_template": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
          "expected_exit_codes": {
            "type": "array", "minItems": 1, "maxItems": 1,
            "items": { "type": "integer" }
          },
          "completion_policy": {
            "enum": ["WAIT_FOR_EXIT", "PASS_IF_RUNNING_AFTER_OBSERVATION"]
          },
          "observation_seconds": { "type": "integer", "minimum": 0, "maximum": 30 },
          "gui_test": { "type": "boolean" },
          "admin_required": { "type": "boolean" },
          "destructive": { "type": "boolean" },
          "side_effect_class": { "enum": ["READ_ONLY", "PROCESS_EXECUTION"] },
          "resource_units": { "type": "integer", "minimum": 1, "maximum": 100 },
          "max_retries": { "type": "integer", "minimum": 0, "maximum": 1 },
          "supported_gui_operation": {
            "type": ["string", "null"],
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "evidence_requirements": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requires_test_passes": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
          }
        }
      }
    }
  }
}
