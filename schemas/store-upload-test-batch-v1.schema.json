{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shihuiarenjinba-png/Windows-all-auto/schemas/store-upload-test-batch-v1.schema.json",
  "title": "Store upload test batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "automator", "candidates"],
  "properties": {
    "schema_version": {"const": "store-upload-test-batch-v1"},
    "automator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit_sha"],
      "properties": {
        "repository": {"const": "shihuiarenjinba-png/Windows-Automator"},
        "branch": {"type": "string", "pattern": "^codex/[A-Za-z0-9._/-]+$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id", "product_type", "artifact_source", "identity",
          "readiness", "windows_automator_input"
        ],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{3,127}$"},
          "product_type": {"enum": ["APP", "GAME"]},
          "artifact_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository", "artifact_id", "artifact_name", "workflow_run_id",
              "source_sha", "archive_sha256", "package_name",
              "package_sha256", "executable_sha256"
            ],
            "properties": {
              "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "artifact_id": {"type": "integer", "minimum": 1},
              "artifact_name": {"type": "string", "minLength": 1},
              "workflow_run_id": {"type": "integer", "minimum": 1},
              "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "package_name": {"type": "string", "pattern": "(?i)\\.msix$"},
              "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["store_id", "name", "publisher", "version"],
            "properties": {
              "store_id": {"type": "string", "pattern": "^[A-Za-z0-9]{8,32}$"},
              "name": {"type": "string", "minLength": 1},
              "publisher": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_status", "evidence_return_e2e_pass", "product_e2e_pass",
              "checker_verdict", "official_identity_reverified",
              "security_owner_confirmed", "listing_assets_ready"
            ],
            "properties": {
              "test_status": {"const": "TEST_PASS"},
              "evidence_return_e2e_pass": {"const": true},
              "product_e2e_pass": {"const": true},
              "checker_verdict": {"const": "READY_CANDIDATE_NOT_CERTIFIED"},
              "official_identity_reverified": {"const": true},
              "security_owner_confirmed": {"const": true},
              "listing_assets_ready": {"const": true}
            }
          },
          "windows_automator_input": {"type": "object"}
        }
      }
    }
  }
}
